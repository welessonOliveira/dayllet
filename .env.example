# Copie para .env e troque a senha.
# Banco local (PostgreSQL 17). Veja o README: "Banco de dados local".
DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/financas_dev?schema=public"
# Banco SÓ de teste: é apagado e recriado a cada `npm run test`.
TEST_DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/financas_test?schema=public"

# Auth.js: chave que assina o cookie de login (gere com: npx auth secret)
AUTH_SECRET="troque-por-uma-chave-aleatoria"
# Login com GitHub (opcional). Crie um OAuth App em github.com/settings/developers
# com callback http://localhost:3000/api/auth/callback/github
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
