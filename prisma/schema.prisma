// Schema do app Finanças (v2, multiusuário).
// Dinheiro sempre em centavos (Int). Datas em UTC.
// Regra de ouro: toda tabela de dado do usuário tem userId, e toda consulta filtra por ele.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) pras migrations. Na Vercel+Neon vem pronta; no PC é igual à DATABASE_URL.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PAID
  PENDING
}

enum Frequency {
  WEEKLY
  MONTHLY
  YEARLY
}

enum ImportFormat {
  OFX
  CSV
}

enum ImportStatus {
  REVIEW // esperando o usuário revisar
  COMMITTED // virou transações
  DISCARDED // descartado
}

enum RowDecision {
  IMPORT
  SKIP
}

enum WalletKind {
  CHECKING // conta corrente
  SAVINGS // poupança
  WALLET // carteira / dinheiro vivo
}

// ---------- Usuário e login (tabelas no formato que o Auth.js espera) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  /// true = conta de demonstração (dados resetados de tempos em tempos)
  isDemo        Boolean   @default(false)
  /// Quando os dados de demonstração foram recriados pela última vez.
  demoResetAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  wallets        Wallet[]
  categories     Category[]
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  imports        ImportBatch[]
  categoryRules  CategoryRule[]
  goals          Goal[]
  transfers      Transfer[]
}

/// Conta de LOGIN (ex.: GitHub). Nome exigido pelo Auth.js.
/// Não confundir com Wallet, que é a conta financeira.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Finanças ----------

/// Conta FINANCEIRA (corrente, poupança, carteira). Na tela aparece como "Conta".
model Wallet {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  kind                WalletKind      @default(CHECKING)
  /// Saldo que a conta já tinha antes do primeiro lançamento no app.
  openingBalanceCents Int             @default(0)
  /// Conta usada quando o lançamento não diz qual (só uma por usuário).
  isDefault           Boolean         @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  transactions        Transaction[]
  recurringRules      RecurringRule[]
  imports             ImportBatch[]
  transfersOut        Transfer[]      @relation("TransferFrom")
  transfersIn         Transfer[]      @relation("TransferTo")

  @@unique([userId, name])
  @@index([userId])
}

/// Transferência entre contas do mesmo usuário (Decisão 18, ajustada).
/// Não é receita nem despesa: só tira de uma conta e põe na outra.
model Transfer {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromWalletId String
  fromWallet   Wallet   @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Restrict)
  toWalletId   String
  toWallet     Wallet   @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Restrict)
  amountCents  Int
  date         DateTime
  note         String?
  createdAt    DateTime @default(now())

  @@index([userId, date])
}

model Category {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  type           CategoryType
  color          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  transactions   Transaction[]
  budgets        Budget[]
  recurringRules RecurringRule[]
  categoryRules  CategoryRule[]

  // Nome único POR USUÁRIO (dois usuários podem ter "Lazer").
  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String
  // Restrict: conta com lançamentos não pode ser apagada.
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  description String
  amountCents Int
  // Repete o tipo da categoria pra facilitar os filtros.
  // O servidor sempre confere se bate com Category.type.
  type        CategoryType
  status      TransactionStatus @default(PAID)
  date        DateTime
  categoryId  String
  // Restrict: categoria com transações não pode ser apagada.
  category    Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  notes       String?

  // Origem: gerado por uma regra recorrente/parcelada (Decisão 19).
  recurringRuleId String?
  // SetNull: apagar a regra mantém os lançamentos que já existiam (o histórico).
  recurringRule   RecurringRule? @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  /// Data ORIGINAL da ocorrência na regra. É a identidade dela: se o usuário
  /// mudar a `date` do lançamento, a regra não gera outro igual.
  occurrenceDate  DateTime?
  /// Parcela N de M (só no parcelado).
  installmentNo   Int?
  installmentOf   Int?

  // Origem: importado de extrato (Decisão 20).
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  /// FITID do OFX ou hash da linha do CSV. Importar o mesmo lançamento 2x na mesma conta é impossível.
  externalId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Gerar 2x a mesma ocorrência (duas abas abertas, por exemplo) é impossível.
  @@unique([recurringRuleId, occurrenceDate])
  @@unique([walletId, externalId])
  @@index([userId, date])
  @@index([categoryId])
  @@index([walletId])
}

/// Conta fixa (todo mês/semana/ano) ou compra parcelada.
/// Os lançamentos são criados "na leitura", até o mês que está sendo visto.
model RecurringRule {
  id           String       @id @default(cuid())
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId     String
  wallet       Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type         CategoryType
  description  String
  /// Recorrente: valor de CADA ocorrência. Parcelado: valor TOTAL (dividido nas parcelas).
  amountCents  Int
  frequency    Frequency    @default(MONTHLY)
  /// Primeira ocorrência (12:00 UTC). O dia dela define o dia das próximas.
  startDate    DateTime
  /// Última data possível (inclusiva). null = sem fim.
  endDate      DateTime?
  /// Parcelado: número de parcelas. null = recorrente.
  installments Int?
  notes        String?
  /// false = pausada (não gera mais nada).
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  transactions Transaction[]
  skips        RecurringSkip[]

  @@index([userId])
}

/// Um upload de extrato. Fica em REVIEW até o usuário confirmar (Decisão 20).
model ImportBatch {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId    String
  wallet      Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  fileName    String
  /// SHA-256 do arquivo: subir o mesmo arquivo de novo é barrado.
  fileHash    String
  format      ImportFormat
  status      ImportStatus @default(REVIEW)
  createdAt   DateTime     @default(now())
  committedAt DateTime?

  rows         ImportRow[]
  transactions Transaction[]

  @@index([userId, status])
  @@index([walletId, fileHash])
}

/// Uma linha do extrato na área de revisão (antes de virar Transaction).
model ImportRow {
  id                  String       @id @default(cuid())
  batchId             String
  batch               ImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// Posição no arquivo (pra manter a ordem).
  position            Int
  date                DateTime
  /// Sempre positivo; o sinal vira o `type`.
  amountCents         Int
  type                CategoryType
  description         String
  externalId          String
  /// Categoria sugerida pelas regras (ou null).
  suggestedCategoryId String?
  /// Categoria escolhida (começa igual à sugerida).
  categoryId          String?
  /// true quando o usuário escolheu a categoria desta linha na mão (a propagação não mexe nela)
  categoryChosen      Boolean      @default(false)
  /// Já existe no extrato da conta? (mesmo externalId = certeza; parecido = possível)
  duplicateOfId       String?
  possibleDuplicate   Boolean      @default(false)
  decision            RowDecision  @default(IMPORT)

  @@index([batchId, position])
}

/// Regra aprendida: descrição com esse padrão -> essa categoria (Decisão 21).
model CategoryRule {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Palavras normalizadas, ex.: "UBER TRIP".
  pattern    String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Quantas vezes a regra foi confirmada (desempate).
  hits       Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, pattern])
  @@index([userId])
}

/// Meta de economia (Decisão 13): "PC novo: R$ 4.000 até março".
model Goal {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  targetCents   Int
  /// Data alvo (12:00 UTC) ou null = sem prazo.
  targetDate    DateTime?
  color         String?
  /// true = arquivada (escondida da lista principal).
  archived      Boolean            @default(false)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  contributions GoalContribution[]

  @@unique([userId, name])
  @@index([userId])
}

/// Dinheiro guardado (positivo) ou retirado (negativo) de uma meta.
model GoalContribution {
  id          String   @id @default(cuid())
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  /// Positivo = guardou; negativo = tirou.
  amountCents Int
  date        DateTime
  note        String?
  createdAt   DateTime @default(now())

  @@index([goalId, date])
}

/// Cache de índices de inflação (Decisão 23). Global: não é dado de usuário.
model IndexRate {
  /// "IPCA" (série 433 do SGS/Banco Central).
  series    String
  /// "YYYY-MM"
  month     String
  /// Variação do mês em pontos-base: 0,42% = 42. Inteiro, sem float.
  rateBps   Int
  fetchedAt DateTime @default(now())

  @@id([series, month])
}

/// Ocorrência que o usuário apagou de propósito: a regra não gera de novo.
model RecurringSkip {
  ruleId         String
  rule           RecurringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  occurrenceDate DateTime

  @@id([ruleId, occurrenceDate])
}

model Budget {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId String
  // Cascade: apagar a categoria apaga os orçamentos dela.
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      String // "YYYY-MM"
  limitCents Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // A categoria já é de um usuário só, então isso também é "por usuário".
  @@unique([categoryId, month])
  @@index([userId, month])
}
